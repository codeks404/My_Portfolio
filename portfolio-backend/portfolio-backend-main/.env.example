# Copy this file to .env and fill in your real values. Never commit .env.

PORT=5000

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/portfolio?retryWrites=true&w=majority

# Frontend origin allowed to call this API (your Vercel URL)
CLIENT_ORIGIN=https://kumkumshakya-portfolio.vercel.app

# Email (Gmail example - use an App Password, not your real password)
EMAIL_USER=youremail@gmail.com
EMAIL_PASS=your_16_char_app_password
EMAIL_TO=kumkumshakya1027@gmail.com
